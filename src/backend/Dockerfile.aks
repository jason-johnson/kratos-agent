# syntax=docker/dockerfile:1.7

ARG PYTHON_IMAGE=python:3.11.14-slim-bookworm
ARG NODE_IMAGE=node:20.19.5-bookworm-slim

FROM ${NODE_IMAGE} AS node-tools

ARG COPILOT_CLI_VERSION=1.0.102

WORKDIR /opt/mocks

COPY mocks/package.json mocks/package-lock.json ./
COPY mocks/packages/m365-graph-mcp-server/ packages/m365-graph-mcp-server/

RUN --mount=type=secret,id=npmrc,target=/root/.npmrc,required=true \
    npm install --global "@github/copilot@${COPILOT_CLI_VERSION}" \
    && npm ci --ignore-scripts --no-audit --no-fund \
        --workspace packages/m365-graph-mcp-server \
    && npm run build --workspace packages/m365-graph-mcp-server \
    && m365_package="$(npm pack ./packages/m365-graph-mcp-server --pack-destination /tmp --silent)" \
    && npm install --global "/tmp/${m365_package}" \
    && rm "/tmp/${m365_package}" \
    && npm cache clean --force \
    && rm -rf \
        /usr/local/lib/node_modules/corepack \
        /usr/local/lib/node_modules/npm \
        /usr/local/bin/corepack \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/bin/yarn \
        /usr/local/bin/yarnpkg

FROM ${PYTHON_IMAGE}

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GIT_PYTHON_REFRESH=quiet \
    HOME=/home/kratos \
    PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-tools /usr/local/ /usr/local/
COPY src/backend/requirements.lock .

RUN --mount=type=secret,id=pip_index_url,required=true \
    PIP_INDEX_URL="$(cat /run/secrets/pip_index_url)" \
    PIP_EXTRA_INDEX_URL="" \
    pip install --no-cache-dir --requirement requirements.lock \
    && python -m pip uninstall --yes pip wheel \
    && rm -f /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.11 \
    && rm -rf /usr/local/lib/python3.11/ensurepip/_bundled

RUN groupadd --gid 10001 kratos \
    && useradd --uid 10001 --gid kratos --create-home --shell /usr/sbin/nologin kratos

COPY --chown=kratos:kratos src/backend/ .
COPY --chown=kratos:kratos use-cases/ use-cases/

USER 10001:10001

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
