# GitHub Copilot token — get one at https://github.com/settings/tokens
COPILOT_GITHUB_TOKEN=

# Private package feeds required by the AKS Dockerfile used by Compose.
# PRIVATE_NPMRC is a filesystem path, not file contents.
PRIVATE_PYPI_INDEX_URL=
PRIVATE_NPMRC=

# Optional production ServiceNow contract. Keep blank to leave the integration
# explicitly unavailable in local mode; never commit real values.
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
