# ── Local Docker Compose stack (backend + Azurite) ────────────────────────────
# Copy to .env and fill in. `docker compose` reads this file automatically.
# These values drive local development; AKS gets its configuration from Helm.

# GitHub Copilot token the local backend uses to reach api.githubcopilot.com.
COPILOT_GITHUB_TOKEN=

# Private package feeds are required for image builds. PRIVATE_NPMRC is a path,
# not the file contents. Keep both values out of source control.
PRIVATE_PYPI_INDEX_URL=
PRIVATE_NPMRC=
