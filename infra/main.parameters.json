{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "deployAks": {
      "value": "${DEPLOY_AKS=false}"
    },
    "aksClusterName": {
      "value": "${AKS_CLUSTER_NAME=}"
    },
    "aksNamespace": {
      "value": "${AKS_NAMESPACE=kratos-agent}"
    },
    "aksAlertActionGroupId": {
      "value": "${AKS_ALERT_ACTION_GROUP_ID=}"
    },
    "deployHealthModel": {
      "value": "${DEPLOY_HEALTH_MODEL=false}"
    },
    "serviceNowInstanceUrl": {
      "value": "${SERVICENOW_INSTANCE_URL=}"
    },
    "serviceNowClientId": {
      "value": "${SERVICENOW_CLIENT_ID=}"
    },
    "serviceNowClientSecret": {
      "value": "${SERVICENOW_CLIENT_SECRET=}"
    }
  }
}
