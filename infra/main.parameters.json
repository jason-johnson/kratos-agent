{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "aksClusterName": {
      "value": "${AKS_CLUSTER_NAME=}"
    },
    "aksNamespace": {
      "value": "${AKS_NAMESPACE=kratos-agent}"
    },
    "aksOperatorPrincipalId": {
      "value": "${AKS_OPERATOR_PRINCIPAL_ID=}"
    },
    "aksServiceCidr": {
      "value": "${AKS_SERVICE_CIDR=10.1.0.0/16}"
    },
    "aksDnsServiceIp": {
      "value": "${AKS_DNS_SERVICE_IP=10.1.0.10}"
    },
    "aksPodCidr": {
      "value": "${AKS_POD_CIDR=10.244.0.0/16}"
    },
    "aksAlertActionGroupId": {
      "value": "${AKS_ALERT_ACTION_GROUP_ID=}"
    },
    "frontendUrl": {
      "value": "${FRONTEND_URL=}"
    },
    "authRedirectUri": {
      "value": "${AUTH_REDIRECT_URI=}"
    },
    "foundryModelCapacity": {
      "value": "${FOUNDRY_MODEL_CAPACITY=250}"
    }
  }
}
