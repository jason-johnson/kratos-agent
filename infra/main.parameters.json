{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "aksClusterName": {
      "value": "${AKS_CLUSTER_NAME=}"
    },
    "aksNamespace": {
      "value": "${AKS_NAMESPACE=kratos-agent}"
    },
    "aksAlertActionGroupId": {
      "value": "${AKS_ALERT_ACTION_GROUP_ID=}"
    },
    "frontendUrl": {
      "value": "${FRONTEND_URL=}"
    }
  }
}
