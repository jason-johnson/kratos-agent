{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "deployHealthModel": {
      "value": "${DEPLOY_HEALTH_MODEL=false}"
    },
    "serviceNowInstanceUrl": {
      "value": "${SERVICENOW_INSTANCE_URL=}"
    },
    "serviceNowClientId": {
      "value": "${SERVICENOW_CLIENT_ID=}"
    },
    "serviceNowClientSecret": {
      "value": "${SERVICENOW_CLIENT_SECRET=}"
    }
  }
}
