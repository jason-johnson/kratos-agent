# Root .dockerignore — the backend AKS image builds from the repository root.
# Its Dockerfile only copies mocks/, src/backend/, and use-cases/.
# Keep the build context small to avoid huge transfers and "no space left on device".

# Virtual environments (src/backend/.venv ~536MB)
**/.venv
**/venv
**/.virtualenv

# Node modules (src/frontend ~347MB, mocks build output is reinstalled in image)
**/node_modules

# Python caches / build artifacts
**/__pycache__
**/*.pyc
**/*.pyo
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.egg-info
**/build/
**/dist/

# Frontend is built with its own image context.
src/frontend/

# Scripts and infrastructure are not needed in the backend image.
scripts/
infra/
deploy/

# Test artifacts
**/test-results/
**/playwright-report/
test-results/

# Git / editor / OS
.git/
.github/
**/.DS_Store
**/.vscode/
*.log
